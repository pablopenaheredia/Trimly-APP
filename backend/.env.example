# ============================================
# VARIABLES DE ENTORNO - BACKEND
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Reemplaza los valores con tus credenciales reales

# Base de Datos (Supabase)
# Obtén estos valores desde: Supabase Dashboard → Settings → Database
DB_HOST=db.xxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password_de_supabase
DB_DATABASE=postgres

# Entorno (development o production)
NODE_ENV=development

# Frontend URL para CORS
# En desarrollo: http://localhost:5173
# En producción: https://tu-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Puerto del servidor backend
PORT=3000

# Auth (JWT)
# En producción DEBE ser un secreto largo y aleatorio.
JWT_SECRET=change_me_in_production
# Ejemplos: 12h, 1d, 3600s
JWT_EXPIRES_IN=12h
