# Variables de entorno para el backend (no subir a git)
# Rellena con las credenciales de tu servicio MySQL externo (Railway u otro)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=your-database-name
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
